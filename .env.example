# GCP Vertex AI & Cloud Services Configuration
# GCP_PROJECT: Your Google Cloud Project ID (e.g. "my-project-123456")
GCP_PROJECT="YOUR_GCP_PROJECT_ID"

# GCP_REGION: Vertex AI location (e.g. "eu", "us", "europe-west2" or "global")
GCP_REGION="eu"

# Gemini Models Configuration
# GEMINI_CHAT_MODEL: Primary model for conversation and pedagogical grammar notes.
# Recommended: "gemini-2.5-flash" (or "gemini-2.0-flash")
GEMINI_CHAT_MODEL="gemini-3.5-flash"

# GEMINI_TTS_MODEL: Model for Gemini multimodal audio/speech generation.
# Use a speech-generation (TTS) model; general chat models may not return audio.
# Recommended: "gemini-3.8-flash-lite-tts"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# GEMINI_LIVE_MODEL: Native-audio model for real-time voice calls (Live API).
# On Vertex AI it is served only from the "us" and "eu" multi-regions (not
# "global"), so set GCP_REGION to one of those if voice calls fail to connect.
GEMINI_LIVE_MODEL="gemini-3.8-live"

# GEMINI_MODEL: Generic model fallback if specific chat/tts models are not set.
GEMINI_MODEL="gemini-2.5-flash"

# Google AI Studio API Key (Fallback if Vertex AI / ADC credentials are not configured)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server configuration
PORT=3000

# Max billed API requests (/api/chat, /api/tts, /api/stt) per IP per minute
RATE_LIMIT_PER_MINUTE=60

# Number of reverse proxies in front of the app (set to 1 on Cloud Run) so
# rate limiting sees the real client IP
TRUST_PROXY_HOPS=0
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ENFORCE_AUTH: Require verified ID tokens outside production too (always on when NODE_ENV=production)
# ENFORCE_AUTH="true"
# GOOGLE_CLIENT_ID: OAuth client ID expected as the audience of Google Identity tokens.
# Firebase tokens use GCP_PROJECT as their audience. With auth enforced, at least one must be set.
# GOOGLE_CLIENT_ID="YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# ALLOW_AI_STUDIO_FALLBACK: Let learner data fail over from Vertex AI to Google AI Studio (default off)
# ALLOW_AI_STUDIO_FALLBACK="false"
# METRICS_ADMIN_USER_IDS: Comma-separated user IDs allowed to read /api/metrics when auth is enforced
# METRICS_ADMIN_USER_IDS=""

# Anonymous Firebase sign-in for the web client (public web config from the Firebase console).
# Uses GCP_PROJECT as the Firebase project. Leave unset locally to use dev identities.
# FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
# FIREBASE_APP_ID="1:000000000000:web:0000000000000000"
# FIREBASE_AUTH_DOMAIN defaults to "<GCP_PROJECT>.firebaseapp.com"

# SESSION_STORE: Where learner sessions are kept: "memory" (default, lost on restart) or "firestore"
# (needs a Firestore database in GCP_PROJECT and Application Default Credentials).
# SESSION_STORE="memory"
